# Copy to .env. Never commit real keys.
N8N_BASE_URL=
# OpenAI-compatible endpoint for the explanation step (Nebius or other). Used by the AI HTTP node.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Copernicus Data Space (Sentinel-2 NDVI). Create an OAuth client in the CDSE dashboard.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Optional paid Open-Meteo key for scripts/fetch-climate-cells.js (free tier is about 5 climate cells a day per IP).
OPEN_METEO_API_KEY=
