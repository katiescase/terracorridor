{
  "name": "terracorridor",
  "version": "0.2.0",
  "private": true,
  "description": "Pipeline compliance platform: one record per kilometre for class location, geohazards, land obligations and encroachment, with one approval trail.",
  "scripts": {
    "test": "node --test test/engine.test.js test/dashboard-api.test.js test/workflows.test.js test/corridors.test.js test/platform.test.js test/growth.test.js test/ngtl-w2-cache.test.js",
    "demo": "node scripts/make-demo.js",
    "build": "node scripts/make-platform-data.js && node scripts/build.js && node scripts/make-api-workflow.js",
    "features": "node ml/features.js",
    "train": "python ml/train.py",
    "validate": "node scripts/validate-workflows.js",
    "wire": "node scripts/wire-workflows.js",
    "api-workflow": "node scripts/make-api-workflow.js",
    "tables": "node scripts/tables.js",
    "fetch-cells": "node scripts/fetch-climate-cells.js && node scripts/make-seed-workflow.js",
    "fetch-crossings": "node scripts/fetch-crossings.js",
    "seed-workflow": "node scripts/make-seed-workflow.js",
    "snapshot": "node scripts/make-snapshot.js",
    "email-workflow": "node scripts/make-email-workflow.js",
    "fetch-forecasts": "node scripts/fetch-forecasts.js",
    "fetch-solar": "node scripts/fetch-solar.js",
    "check-forecast": "node scripts/check-forecast.js",
    "test:browser": "node scripts/smoke-browser.js",
    "prepare-bc": "node scripts/prepare-bc-corridor.js && node scripts/make-bc-seed.js",
    "test:corridors": "node scripts/smoke-corridors.js",
    "refresh-bc-weather": "node scripts/refresh-bc-weather.js && npm run prepare-bc",
    "check-bc-forecast": "node scripts/check-bc-forecast.js",
    "verify-bc-inputs": "node scripts/verify-bc-inputs.js",
    "record-bc-inputs": "node scripts/verify-bc-inputs.js --record",
    "verify-bc-route": "node scripts/verify-bc-route.js",
    "refresh-bc-climate": "node scripts/refresh-bc-climate.js",
    "platform-workflows": "node scripts/make-platform-workflows.js",
    "platform-data": "node scripts/make-platform-data.js",
    "fetch-permits": "node scripts/fetch-permits.js"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
